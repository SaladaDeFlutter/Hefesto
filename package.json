{
  "name": "@saladadeflutter/hefesto",
  "version": "2026.11.19",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "npm --prefix packages/web run build",
    "prestart": "node scripts/ensure-port.ts",
    "start": "npm run build && node packages/server/src/index.ts",
    "start:server": "node packages/server/src/index.ts",
    "dev": "npm run start",
    "typecheck": "tsc -p packages/server && tsc -p packages/web",
    "smoke": "node scripts/smoke-web.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "hefesto": "bin/hefesto.mjs"
  },
  "files": [
    "bin/",
    "docs/",
    "packages/core/src/",
    "packages/engine/src/",
    "packages/server/src/",
    "packages/connectors/catalog.ts",
    "packages/connectors/discord/",
    "packages/web/dist/",
    "scripts/ensure-port.ts",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord.js": "^14.28.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "A forja local de agentes opencode: instâncias isoladas, chat, modelos e conectores MCP.",
  "engines": {
    "node": ">=26"
  }
}
