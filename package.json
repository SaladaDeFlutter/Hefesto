{
  "name": "hefesto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "npm --prefix packages/web run build",
    "prestart": "node scripts/ensure-port.ts",
    "start": "npm run build && node packages/server/src/index.ts",
    "start:server": "node packages/server/src/index.ts",
    "dev": "npm run start",
    "typecheck": "tsc -p packages/server && tsc -p packages/web",
    "smoke": "node scripts/smoke-web.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
